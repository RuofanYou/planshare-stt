{
  "name": "planshare",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "STT 战术板分享平台 —— 让会写战术板的人有舞台，不会写的人有得抄",
  "scripts": {
    "dev": "concurrently -n web,server -c cyan,magenta \"npm:dev:web\" \"npm:dev:server\"",
    "dev:e2e": "concurrently -n web,server -c cyan,magenta \"vite --port 5183 --strictPort\" \"node server/index.mjs\"",
    "dev:web": "vite",
    "dev:server": "node server/index.mjs",
    "start": "node server/index.mjs",
    "serve": "node --env-file=.env server/index.mjs",
    "sync:stt-translator": "node scripts/sync-stt-translator-assets.mjs",
    "check:stt-translator": "node scripts/sync-stt-translator-assets.mjs --check",
    "prepare:stt-skill": "node scripts/prepare-stt-skill.mjs",
    "test:stt-skill": "NODE_PATH=./node_modules node ../Tools/stt-harness/run.js skill_writer_spec.lua",
    "test": "npm run check:stt-translator && npm run test:stt-skill && node --test --test-concurrency=1 server/*.test.mjs",
    "test:e2e": "npm run sync:stt-translator && playwright test",
    "verify:loot-data": "node scripts/verify-loot-12-1-data.mjs",
    "verify": "npm run sync:stt-translator && npm run verify:loot-data && tsc -b && vite build && npm run prepare:stt-skill && npm run test:stt-skill && node --test --test-concurrency=1 server/*.test.mjs && playwright test",
    "test:security": "node --test server/security.test.mjs",
    "remote:export": "node scripts/remote-data.mjs export",
    "remote:import": "node scripts/remote-data.mjs import",
    "cloudrun:persistent:preflight": "node scripts/cloudrun-persistent.mjs preflight",
    "d1:seed": "node scripts/generate-d1-import.mjs",
    "prepare:voice-pack": "node scripts/prepare-voice-pack.mjs",
    "worker:dev": "wrangler dev --config wrangler.api.jsonc --local --port 8787",
    "worker:deploy": "wrangler deploy --config wrangler.api.jsonc",
    "verify:log": "npm --prefix RaidGlass/frontend run verify",
    "deploy:log:preview": "npm --prefix RaidGlass/frontend run deploy:preview",
    "deploy:log": "npm --prefix RaidGlass/frontend run deploy:production",
    "deploy:log:legacy-redirect": "wrangler pages deploy RaidGlass/legacy-wowlogs-redirect --project-name wowlogs --branch main --commit-dirty=true --skip-caching",
    "deploy:pages:preview": "npm run build && wrangler pages deploy --commit-dirty=true --skip-caching",
    "deploy:pages": "npm run build && wrangler pages deploy --branch main --commit-dirty=true --skip-caching",
    "build": "npm run sync:stt-translator && npm run prepare:voice-pack && tsc -b && vite build && npm run prepare:stt-skill",
    "preview": "vite preview"
  },
  "dependencies": {
    "@fastify/cors": "^11.2.0",
    "@fastify/static": "^9.1.3",
    "@react-three/drei": "^9.122.0",
    "@react-three/fiber": "^8.18.0",
    "@remotion/player": "^4.0.506",
    "@tailwindcss/vite": "^4.3.0",
    "@tanstack/react-query": "^5.100.14",
    "better-sqlite3": "^12.10.0",
    "concurrently": "^10.0.1",
    "fastify": "^5.8.5",
    "fengari": "^0.1.5",
    "fflate": "^0.8.3",
    "framer-motion": "^12.40.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2",
    "remotion": "^4.0.506",
    "tailwindcss": "^4.3.0",
    "three": "^0.184.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@types/three": "^0.184.1",
    "@vitejs/plugin-react": "^4.3.1",
    "typescript": "^5.5.4",
    "vite": "^5.4.6",
    "wrangler": "^4.97.0"
  }
}
