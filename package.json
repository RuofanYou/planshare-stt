{
  "name": "planshare",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "STT 战术板分享平台 —— 让会写战术板的人有舞台，不会写的人有得抄",
  "scripts": {
    "dev": "concurrently -n web,server -c cyan,magenta \"npm:dev:web\" \"npm:dev:server\"",
    "dev:web": "vite",
    "dev:server": "node server/index.mjs",
    "start": "node server/index.mjs",
    "serve": "node --env-file=.env server/index.mjs",
    "test": "node --test server/*.test.mjs",
    "test:security": "node --test server/security.test.mjs",
    "remote:export": "node scripts/remote-data.mjs export",
    "remote:import": "node scripts/remote-data.mjs import",
    "build": "tsc -b && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "@fastify/cors": "^11.2.0",
    "@fastify/static": "^9.1.3",
    "@react-three/drei": "^9.122.0",
    "@react-three/fiber": "^8.18.0",
    "@tailwindcss/vite": "^4.3.0",
    "@tanstack/react-query": "^5.100.14",
    "better-sqlite3": "^12.10.0",
    "concurrently": "^10.0.1",
    "fastify": "^5.8.5",
    "framer-motion": "^12.40.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2",
    "tailwindcss": "^4.3.0",
    "three": "^0.184.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@types/three": "^0.184.1",
    "@vitejs/plugin-react": "^4.3.1",
    "typescript": "^5.5.4",
    "vite": "^5.4.6"
  }
}
