{
  "name": "raidglass-edge",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "dry-run:production": "wrangler deploy --dry-run --env= --config wrangler.jsonc",
    "dry-run:preview": "wrangler deploy --dry-run --env preview --config wrangler.jsonc",
    "migrate:production": "wrangler d1 migrations apply RANKING_DB --remote --config wrangler.jsonc",
    "migrate:preview": "wrangler d1 migrations apply RANKING_DB --remote --env preview --config wrangler.jsonc",
    "deploy:production": "wrangler deploy --env= --config wrangler.jsonc",
    "deploy:preview": "wrangler deploy --env preview --config wrangler.jsonc",
    "cron:disable:production": "wrangler triggers deploy --env= --config wrangler.jsonc",
    "cron:disable:preview": "wrangler triggers deploy --env preview --config wrangler.jsonc",
    "cron:preview:minute": "wrangler triggers deploy --env preview --triggers \"* * * * *\" --config wrangler.jsonc"
  },
  "devDependencies": {
    "miniflare": "4.20260730.0",
    "wrangler": "4.120.0"
  },
  "overrides": {
    "miniflare@4.20260730.0": {
      "undici": "7.29.0"
    }
  }
}
