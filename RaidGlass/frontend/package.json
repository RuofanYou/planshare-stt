{
  "name": "raidglass-frontend",
  "type": "module",
  "description": "RaidGlass web app for Warcraft Logs top timeline references",
  "version": "0.2.0",
  "author": "RaidGlass",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": ""
  },
  "scripts": {
    "dev": "vite",
    "server": "vite",
    "typecheck": "tsc --noEmit -p tsconfig.verify.json",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "test:worker": "node --test scripts/tests/worker-contract.test.mjs",
    "test:node": "node --test scripts/tests/*.test.mjs",
    "test:e2e": "node scripts/run-e2e.mjs",
    "test:e2e:direct": "playwright test",
    "prepare:assets": "node scripts/prepare-cloudflare-assets.mjs",
    "verify:release": "node scripts/verify-release.mjs",
    "verify:live": "node scripts/verify-live.mjs",
    "verify:artifact": "npm run typecheck && npm run test:unit && npm run test:node && npm run verify:release && RAIDGLASS_E2E_FIXTURE=generated npm run test:e2e",
    "verify": "npm run verify:artifact",
    "build": "vite build",
    "build:candidate": "node scripts/build-candidate.mjs",
    "deploy:production": "test -n \"$RAIDGLASS_BUILD_DIR\" && wrangler deploy --env= --config wrangler.jsonc --assets \"$RAIDGLASS_BUILD_DIR\"",
    "deploy:preview": "test -n \"$RAIDGLASS_BUILD_DIR\" && wrangler deploy --env preview --config wrangler.jsonc --assets \"$RAIDGLASS_BUILD_DIR\"",
    "preview": "vite preview"
  },
  "dependencies": {
    "@ctrl/react-adsense": "^1.8.0",
    "@reduxjs/toolkit": "^2.5.1",
    "@szhsin/react-menu": "^4.3.0",
    "html-react-parser": "^5.2.2",
    "jwt-decode": "^4.0.0",
    "konva": "^9.3.18",
    "moment": "^2.30.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-helmet-async": "^3.0.0",
    "react-hook-form": "^7.54.2",
    "react-icons": "^5.4.0",
    "react-redux": "^9.2.0",
    "react-router": "^7.1.5",
    "react-router-dom": "^7.1.5",
    "react-use": "^17.6.0",
    "redux": "^5.0.1",
    "reselect": "^5.1.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.20.1",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^29.1.1",
    "rollup-plugin-visualizer": "^5.14.0",
    "sass": "^1.85.0",
    "sass-embedded": "^1.85.0",
    "typescript": "^7.0.2",
    "vite": "^6.1.0",
    "vite-plugin-radar": "^0.10.0",
    "vitest": "^4.1.10",
    "wrangler": "^4.110.0"
  }
}
