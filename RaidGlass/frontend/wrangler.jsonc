{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "raidglass-web",
  "main": "./public/_worker.js",
  "compatibility_date": "2026-09-03",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./build",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "d1_databases": [
    {
      "binding": "RANKING_DB",
      "database_name": "raidglass-data",
      "database_id": "7764d3d9-18cc-4506-a58f-de7f473fb47c"
    }
  ],
  "env": {
    "preview": {
      "name": "raidglass-web-preview",
      "d1_databases": [
        {
          "binding": "RANKING_DB",
          "database_name": "raidglass-data-preview",
          "database_id": "bc5f6867-3803-4a0d-9e41-376528090a6f"
        }
      ]
    }
  }
}
